---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
{#- Se arma solo en cada publicación: todas las páginas del sitio (las .html de siempre
    y los artículos del blog), con la fecha de su último cambio. Ya no se edita a mano. -#}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for item in collections.all %}
{%- if item.url and item.url != "/404.html" and not item.data.noindex %}
  <url><loc>{{ sitio.url }}{{ item.url }}</loc><lastmod>{{ (collections.articulos[0] | actualizado) if item.url == "/blog/" and collections.articulos.length else item | actualizado }}</lastmod></url>
{%- endif %}
{%- endfor %}
</urlset>
