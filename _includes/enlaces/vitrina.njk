{#- Diseño 2: "Vitrina".
    Para profesionales y locales que atienden público. Portada de color plano con el nombre grande
    y la inicial gigante de fondo; debajo, una barra de 4 accesos (WhatsApp, Llamar, Cómo llegar,
    Guardar contacto); los motivos de contacto como píldoras y el horario.
    Momento memorable: el estado "Abierto ahora · cierra a las 19:00", calculado con la hora de Chile. -#}
{%- from "enlaces/comun.njk" import icono, ev, listaRedes, datos, bloqueTransferencia, yaCliente, botonContacto -%}
{%- set p = slug_pagina -%}
{%- set principales = (botones or []) | rejectattr("cliente") -%}
<style>
.v{max-width:460px;margin:0 auto;padding-bottom:8px;background:var(--paper);min-height:100vh}

/* 1. Portada de color */
.v-top{position:relative;isolation:isolate;overflow:hidden;padding:20px 20px 78px;background:var(--c);color:#fff;border-radius:0 0 28px 28px}
.v-top::after{content:attr(data-inicial);position:absolute;z-index:-1;right:-14px;bottom:-78px;font:800 280px/1 var(--t);color:#fff;opacity:.09;pointer-events:none}
.v-row{display:flex;align-items:center;justify-content:space-between;gap:12px}
.v-logo{width:60px;height:60px;border-radius:50%;object-fit:cover;background:#fff;box-shadow:0 0 0 3px color-mix(in srgb,#fff 30%,transparent)}
.v-estado{display:none;align-items:center;gap:8px;padding:7px 12px;border-radius:999px;background:color-mix(in srgb,#fff 16%,transparent);font-size:12px;font-weight:600}
.v-estado.is-on{display:inline-flex}
.v-estado i{width:8px;height:8px;border-radius:50%;background:#fca5a5}
.v-estado.abierto i{background:#4ade80;box-shadow:0 0 0 0 rgba(74,222,128,.6);animation:latido 2s ease-out infinite}
@keyframes latido{to{box-shadow:0 0 0 8px rgba(74,222,128,0)}}
.v-k{margin-top:28px;font:700 12px/1.2 var(--t);letter-spacing:.1em;text-transform:uppercase;opacity:.8}
.v-top h1{margin-top:8px;max-width:13ch;font:800 2.1rem/1.05 var(--t);letter-spacing:-.02em}
.v-top h1 em{font-style:normal;color:color-mix(in srgb,var(--c) 25%,#fff)}
.v-b{margin-top:10px;max-width:32ch;opacity:.85}

/* 2. Barra de accesos */
.v-dock{position:relative;margin:-48px 14px 0;display:grid;grid-template-columns:repeat(var(--n,4),1fr);padding:12px 4px;background:#fff;border-radius:18px;box-shadow:var(--e2)}
.v-dock a{display:grid;justify-items:center;gap:6px;padding:4px 2px;text-decoration:none;font-size:12px;font-weight:600;line-height:1.2;text-align:center}
.v-dock .ic{display:grid;place-items:center;width:46px;height:46px;border-radius:50%;background:var(--soft);color:var(--c);transition:transform .2s ease}
.v-dock a:first-child .ic{background:var(--c);color:#fff}
.v-dock a:hover .ic{transform:translateY(-2px)}

/* 3. Motivos de contacto (píldoras) */
.v-sec{margin:30px 20px 0}
.v-sec h2{font:800 1.1rem/1.2 var(--t);letter-spacing:-.01em}
.v-sec > p{margin-top:4px;font-size:13px;color:var(--muted)}
.v-chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
.v-chips a{display:inline-flex;align-items:center;gap:8px;padding:11px 14px;border:1px solid var(--line);border-radius:999px;background:#fff;text-decoration:none;font-size:14px;line-height:1.2;transition:border-color .2s ease,background .2s ease}
.v-chips a b{font-weight:600}
.v-chips a svg{flex:none;color:var(--wa)}
.v-chips a.link svg{color:var(--c-2)}
.v-chips a:hover{border-color:var(--c);background:var(--soft)}

/* 4. Oferta */
.v-oferta{margin:26px 14px 0;padding:20px;border-radius:var(--r-m);background:var(--soft);display:grid;gap:12px}
.v-oferta .k{font:700 11px/1 var(--t);letter-spacing:.1em;text-transform:uppercase;color:var(--c)}
.v-oferta h2{font:800 1.15rem/1.15 var(--t);letter-spacing:-.01em}
.v-oferta p{font-size:14px;color:var(--muted)}
.v-oferta a{justify-self:start;display:inline-flex;align-items:center;gap:8px;height:44px;padding:0 18px;border-radius:999px;background:var(--c);color:#fff;text-decoration:none;font-weight:600;font-size:14px}

/* 5. Horario */
.v-hor{list-style:none;padding:0;margin-top:10px}
.v-hor li{display:flex;justify-content:space-between;gap:12px;padding:9px 0;border-bottom:1px solid var(--line);font-size:14px}
.v-hor li.hoy{font-weight:600;color:var(--c)}
.v-dir{display:flex;align-items:center;gap:10px;margin-top:12px;font-size:14px;color:var(--muted)}
.v-dir svg{flex:none;color:var(--c)}

/* 6. Pie */
.v-foot{margin:30px 20px 0;padding:20px 0 24px;border-top:1px solid var(--line);display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:14px}
.v-links{display:flex;flex-wrap:wrap;gap:6px 16px;font-size:14px;font-weight:600}
.v-links a{text-decoration-color:color-mix(in srgb,var(--c) 40%,transparent);text-underline-offset:4px}
.soc{display:flex;gap:8px}
.soc a{display:grid;place-items:center;width:40px;height:40px;border-radius:50%;border:1px solid var(--line);background:#fff;color:var(--c)}
.credito{width:100%;font-size:12px;color:var(--muted)}
@media (min-width:600px){
  body{padding:40px 0}
  .v{border-radius:22px;overflow:hidden;box-shadow:var(--e1);min-height:0}
}
</style>

{%- set accesos = 1 + (1 if contacto and contacto.telefono else 0) + (1 if redes and redes.google_maps else 0) + (0 if contacto and contacto.guardar == false else 1) %}
<main class="v">
  <header class="v-top" data-inicial="{{ (inicial or title) | first }}">
    <div class="v-row">
      {%- if logo %}<img class="v-logo" src="{{ logo }}" alt="{{ title }}" width="60" height="60">{% else %}<span></span>{% endif %}
      {%- if horario and horario.length %}<span class="v-estado" id="estado" aria-live="polite"><i></i><span></span></span>{% endif %}
    </div>
    {%- if etiqueta %}<p class="v-k">{{ etiqueta }}</p>{% endif %}
    <h1>{{ (titulo or title) | resaltar(titulo_color, "em") | safe }}</h1>
    {%- if bajada %}<p class="v-b">{{ bajada }}</p>{% endif %}
  </header>

  <nav class="v-dock" style="--n:{{ accesos }}" aria-label="Accesos rápidos">
    <a href="{{ whatsapp | wa(mensaje_whatsapp, saludo) }}"{{ ev(p, "WhatsApp") }}><span class="ic">{{ icono("wa", 22) }}</span>WhatsApp</a>
    {%- if contacto and contacto.telefono %}<a href="tel:{{ contacto.telefono | tel }}"{{ ev(p, "Llamar") }}><span class="ic">{{ icono("tel", 20) }}</span>Llamar</a>{% endif %}
    {%- if redes and redes.google_maps %}<a href="{{ redes.google_maps }}"{{ ev(p, "Cómo llegar") }}><span class="ic">{{ icono("maps", 20) }}</span>Cómo llegar</a>{% endif %}
    {%- if not contacto or contacto.guardar != false %}<a href="/enlaces/{{ p }}/contacto.vcf" download="{{ p }}.vcf"{{ ev(p, "Guardar contacto") }}><span class="ic">{{ icono("contacto", 20) }}</span>Guardar contacto</a>{% endif %}
  </nav>

  {%- if principales.length %}
  <section class="v-sec" aria-label="{{ botones_titulo or '¿En qué te ayudo?' }}">
    <h2>{{ botones_titulo or "¿En qué te ayudo?" }}</h2>
    {%- if ayuda %}<p>{{ ayuda }}</p>{% endif %}
    <div class="v-chips">
      {%- for b in principales %}
      <a{% if b.enlace %} class="link"{% endif %} href="{{ b.enlace or (whatsapp | wa(b.mensaje, saludo)) }}"{{ ev(p, b.texto) }}><span>{{ b.texto | resaltar(b.resaltar) | safe }}</span>{{ icono("flecha", 16) if b.enlace else icono("wa", 16) }}</a>
      {%- endfor %}
    </div>
  </section>
  {%- endif %}

  {%- if oferta and oferta.titulo %}
  <section class="v-oferta" aria-label="{{ oferta.titulo }}">
    {%- if oferta.etiqueta %}<p class="k">{{ oferta.etiqueta }}</p>{% endif %}
    <h2>{{ oferta.titulo }}</h2>
    {%- if oferta.texto %}<p>{{ oferta.texto }}</p>{% endif %}
    <a href="{{ oferta.enlace or (whatsapp | wa(oferta.mensaje, saludo)) }}"{{ ev(p, oferta.boton or oferta.titulo) }}>{{ oferta.boton or "Lo quiero" }}</a>
  </section>
  {%- endif %}

  {%- if (horario and horario.length) or (contacto and contacto.direccion) %}
  <section class="v-sec" aria-label="Horario">
    <h2>Horario</h2>
    {%- if horario and horario.length %}
    <ul class="v-hor" id="horario" data-h="{{ horario | dump }}">
      {%- for h in horario %}<li data-dias="{{ h.dias | join(',') }}"><span>{{ h.dias | dias }}</span><span>{{ h.abre }} a {{ h.cierra }}</span></li>{% endfor %}
    </ul>
    {%- endif %}
    {%- if contacto and contacto.direccion %}<p class="v-dir">{{ icono("maps", 18) }}{{ contacto.direccion }}</p>{% endif %}
  </section>
  {%- endif %}

  {{ yaCliente(botones, transferencia, p, clientes_titulo, clientes_bajada, saludo, whatsapp) }}
  {{ datos(datos_copiar, p, datos_titulo) }}

  <footer class="v-foot">
    {%- if enlaces and enlaces.length %}<nav class="v-links" aria-label="Enlaces">{% for l in enlaces %}<a href="{{ l.url }}"{{ ev(p, l.texto) }}>{{ l.texto }}</a>{% endfor %}</nav>{% endif %}
    <div class="soc">{{ listaRedes(redes, p) }}</div>
    {%- if credito != false %}<p class="credito">Página hecha por <a href="https://vluetechservices.cl/"{{ ev(p, "Crédito Vlue") }}>Vlue Tech Services</a></p>{% endif %}
  </footer>
</main>

<script>
/* "Abierto ahora" con la hora de Chile, y marca el día de hoy en el horario. */
(function () {
  var lista = document.getElementById("horario"), estado = document.getElementById("estado");
  if (!lista || !estado) return;
  var H = JSON.parse(lista.getAttribute("data-h") || "[]");
  var DIAS = ["dom", "lun", "mar", "mie", "jue", "vie", "sab"];
  var ahora = new Date(new Date().toLocaleString("en-US", { timeZone: "America/Santiago" }));
  var hoy = DIAS[ahora.getDay()], min = ahora.getHours() * 60 + ahora.getMinutes();
  function m(s) { var p = String(s).split(":"); return +p[0] * 60 + (+p[1] || 0); }
  function de(d) { return H.filter(function (h) { return (h.dias || []).indexOf(d) > -1; }); }
  [].forEach.call(lista.children, function (li) { if (li.dataset.dias.split(",").indexOf(hoy) > -1) li.classList.add("hoy"); });
  var turnos = de(hoy), texto;
  var abierto = turnos.filter(function (h) { return min >= m(h.abre) && min < m(h.cierra); })[0];
  if (abierto) { texto = "Abierto ahora · cierra a las " + abierto.cierra; estado.classList.add("abierto"); }
  else {
    var luego = turnos.filter(function (h) { return min < m(h.abre); })[0];
    if (luego) texto = "Cerrado · abre a las " + luego.abre;
    else {
      for (var k = 1; k <= 7 && !texto; k++) {
        var d = DIAS[(ahora.getDay() + k) % 7], t = de(d)[0];
        if (t) texto = "Cerrado · abre " + (k === 1 ? "mañana" : ["el domingo", "el lunes", "el martes", "el miércoles", "el jueves", "el viernes", "el sábado"][(ahora.getDay() + k) % 7]) + " a las " + t.abre;
      }
    }
  }
  if (texto) { estado.lastElementChild.textContent = texto; estado.classList.add("is-on"); }
})();
</script>
