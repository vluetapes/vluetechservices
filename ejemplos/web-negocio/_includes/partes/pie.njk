{%- set wa = "https://wa.me/" + negocio.whatsapp + "?text=" + (negocio.mensajeWhatsapp | urlencode) -%}
<footer class="pie">
  <div class="wrap">
    <a class="marca" href="/">{{ negocio.nombre }}</a>
    <p>{{ negocio.rubro }} en {{ negocio.comuna }}, {{ negocio.ciudad }}</p>
    {%- if negocio.mostrarDireccion and negocio.direccion %}<p>{{ negocio.direccion }}</p>{% endif %}
    <p>{{ negocio.horario }}</p>
    <nav aria-label="Secciones">
      <a href="/#servicios">Servicios</a>
      <a href="/blog/">Blog</a>
      <a href="tel:{{ negocio.telefono }}" data-evento="clic_llamada" data-ubicacion="pie">{{ negocio.telefonoVisible }}</a>
      {%- if negocio.email %}<a href="mailto:{{ negocio.email }}">{{ negocio.email }}</a>{% endif %}
      {%- if negocio.instagram %}<a href="{{ negocio.instagram }}" target="_blank" rel="noopener">Instagram</a>{% endif %}
      {%- if negocio.facebook %}<a href="{{ negocio.facebook }}" target="_blank" rel="noopener">Facebook</a>{% endif %}
      {%- if negocio.tiktok %}<a href="{{ negocio.tiktok }}" target="_blank" rel="noopener">TikTok</a>{% endif %}
      {%- if negocio.googleMaps %}<a href="{{ negocio.googleMaps }}" target="_blank" rel="noopener">Google Maps</a>{% endif %}
    </nav>
    <p>Sitio hecho por <a href="https://vluetechservices.cl/" target="_blank" rel="noopener">Vlue Tech Services</a></p>
  </div>
</footer>
